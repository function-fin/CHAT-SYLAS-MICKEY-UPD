local function AppendMessage(text)
	local MsgLabel = Instance.new("TextButton")
	MsgLabel.Size = UDim2.new(1, -8, 0, 0)
	MsgLabel.AutomaticSize = Enum.AutomaticSize.Y
	MsgLabel.BackgroundColor3 = COLORS.PanelBlack
	MsgLabel.BackgroundTransparency = 0.55
	MsgLabel.BorderSizePixel = 0
	MsgLabel.AutoButtonColor = false
	MsgLabel.Text = LocalPlayer.DisplayName .. ": " .. text
	MsgLabel.TextColor3 = COLORS.White
	MsgLabel.TextStrokeTransparency = 1
	MsgLabel.Font = Enum.Font.Gotham
	MsgLabel.TextSize = 13
	MsgLabel.TextWrapped = true
	MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
	MsgLabel.Parent = MessagesArea

	local Padding = Instance.new("UIPadding")
	Padding.PaddingTop = UDim.new(0, 6)
	Padding.PaddingBottom = UDim.new(0, 6)
	Padding.PaddingLeft = UDim.new(0, 10)
	Padding.PaddingRight = UDim.new(0, 10)
	Padding.Parent = MsgLabel

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 6)
	Corner.Parent = MsgLabel

	MsgLabel.MouseButton1Click:Connect(function()
		if ChatSettings.CopyText and setclipboard then
			setclipboard(text)
		end
	end)

	task.defer(function()
		MessagesArea.CanvasPosition = Vector2.new(0, MessagesArea.AbsoluteCanvasSize.Y)
	end)
end

local function SendMessage()
	local content = ChatInput.Text
	if content:match("^%s*$") then
		return
	end
	ChatInput.Text = ""
	AppendMessage(content)

	TweenService:Create(PaperPlane, TweenInfo.new(0.1), {
		Position = UDim2.new(0.5, -7, 0.5, -11)
	}):Play()
	task.delay(0.1, function()
		if PaperPlane and PaperPlane.Parent then
			TweenService:Create(PaperPlane, TweenInfo.new(0.1), {
				Position = UDim2.new(0.5, -9, 0.5, -9)
			}):Play()
		end
	end)
end

SendButton.MouseButton1Click:Connect(SendMessage)

ChatInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		SendMessage()
	end
end)

