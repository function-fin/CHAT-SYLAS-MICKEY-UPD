-- Construtor de Botão de Toggle (Switch animado + texto Desativado/Ativado)
local function AddToggleControl(row, defaultState, callback)
	local state = defaultState or false

	local StatusLabel = Instance.new("TextLabel")
	StatusLabel.Size = UDim2.new(0, 62, 0, 22)
	StatusLabel.Position = UDim2.new(1, -72, 0.5, -11)
	StatusLabel.BackgroundTransparency = 1
	StatusLabel.Text = state and "Ativado" or "Desativado"
	StatusLabel.TextColor3 = state and COLORS.White or COLORS.SubText
	StatusLabel.TextStrokeTransparency = 1
	StatusLabel.Font = Enum.Font.Gotham
	StatusLabel.TextSize = 10
	StatusLabel.TextXAlignment = Enum.TextXAlignment.Left
	StatusLabel.ZIndex = 13
	StatusLabel.Parent = row

	local SwitchBg = Instance.new("TextButton")
	SwitchBg.Size = UDim2.new(0, 44, 0, 22)
	SwitchBg.Position = UDim2.new(1, -122, 0.5, -11)
	SwitchBg.BackgroundColor3 = state and COLORS.ToggleOnBg or COLORS.ToggleOffBg
	SwitchBg.BorderSizePixel = 0
	SwitchBg.AutoButtonColor = false
	SwitchBg.Text = ""
	SwitchBg.ZIndex = 13
	SwitchBg.Parent = row

	local SwitchCorner = Instance.new("UICorner")
	SwitchCorner.CornerRadius = UDim.new(1, 0)
	SwitchCorner.Parent = SwitchBg

	local Knob = Instance.new("Frame")
	Knob.Size = UDim2.new(0, 16, 0, 16)
	Knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
	Knob.BackgroundColor3 = state and COLORS.ToggleKnobOn or COLORS.ToggleKnobOff
	Knob.BorderSizePixel = 0
	Knob.ZIndex = 14
	Knob.Parent = SwitchBg

	local KnobCorner = Instance.new("UICorner")
	KnobCorner.CornerRadius = UDim.new(1, 0)
	KnobCorner.Parent = Knob

	SwitchBg.MouseButton1Click:Connect(function()
		state = not state
		StatusLabel.Text = state and "Ativado" or "Desativado"
		StatusLabel.TextColor3 = state and COLORS.White or COLORS.SubText

		local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(SwitchBg, tweenInfo, {
			BackgroundColor3 = state and COLORS.ToggleOnBg or COLORS.ToggleOffBg
		}):Play()
		TweenService:Create(Knob, tweenInfo, {
			Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
			BackgroundColor3 = state and COLORS.ToggleKnobOn or COLORS.ToggleKnobOff
		}):Play()

		if callback then
			callback(state)
		end
	end)
end

