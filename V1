-- 4. APPEND MESSAGE (refeito com RichText + nome do remetente)
-- ==========================================
local function AppendMessage(senderName, displayName, text, isMe, mode)
	if mutedPlayers[senderName] and not isMe then return end

	local MsgLabel = Instance.new("TextButton")
	MsgLabel.Size = UDim2.new(1, -8, 0, 0)
	MsgLabel.AutomaticSize = Enum.AutomaticSize.Y
	MsgLabel.BackgroundColor3 = COLORS.PanelBlack
	MsgLabel.BackgroundTransparency = 0.55
	MsgLabel.BorderSizePixel = 0
	MsgLabel.AutoButtonColor = false
	MsgLabel.RichText = true
	MsgLabel.TextColor3 = COLORS.White
	MsgLabel.Font = Enum.Font.Gotham
	MsgLabel.TextSize = 13
	MsgLabel.TextWrapped = true
	MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
	MsgLabel.Parent = MessagesArea

	local prefix = ""
	if mode == "GLOBAL" then
		prefix = "<font color='rgb(100,200,255)'>[GLOBAL]</font> "
	end

	local nameColor = isMe and "rgb(255,110,110)" or "rgb(180,130,255)"
	local safeName = EscapeRichText(displayName or senderName)
	local safeMsg  = EscapeRichText(text)

	MsgLabel.Text = string.format(
		"%s<font color='%s'>%s:</font> <font color='rgb(240,240,240)'>%s</font>",
		prefix, nameColor, safeName, safeMsg
	)

	local Padding = Instance.new("UIPadding", MsgLabel)
	Padding.PaddingTop = UDim.new(0, 6)
	Padding.PaddingBottom = UDim.new(0, 6)
	Padding.PaddingLeft = UDim.new(0, 10)
	Padding.PaddingRight = UDim.new(0, 10)

	Instance.new("UICorner", MsgLabel).CornerRadius = UDim.new(0, 6)

	-- [NOVO] Clique → copia se CopyText ligado
	MsgLabel.MouseButton1Click:Connect(function()
		if ChatSettings.CopyText then
			if setclipboard then setclipboard(text)
			elseif toclipboard then toclipboard(text) end
			-- feedback: flash branco
			MsgLabel.BackgroundTransparency = 0.1
			TweenService:Create(MsgLabel, TweenInfo.new(0.35), {BackgroundTransparency = 0.55}):Play()
		end
	end)

	-- registro para poder ocultar ao mutar
	if not messagesByUser[senderName] then messagesByUser[senderName] = {} end
	table.insert(messagesByUser[senderName], MsgLabel)

	task.defer(function()
		MessagesArea.CanvasPosition = Vector2.new(0, MessagesArea.AbsoluteCanvasSize.Y)
	end)
end

