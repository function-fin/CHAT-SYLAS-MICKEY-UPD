local function ShowBubble(username, message)
	local plr = Players:FindFirstChild(username)
	if not plr or not plr.Character then return end
	local head = plr.Character:FindFirstChild("Head")
	if not head then return end
	pcall(function()
		ChatService:Chat(head, message, Enum.ChatColor.White)
	end)
end

-- ==========================================
-- 6. WEBSOCKET (PieHost) [NOVO]
-- ==========================================
local socket
local running = true
local isGlobalMode = false

local function ConnectWS()
	if not running then return end
	local ok, res = pcall(function() return WebSocket.connect(WS_URL) end)

	if ok and res then
		socket = res
		print("[PrivateChat] Conectado ao PieHost.")

		socket.OnMessage:Connect(function(raw)
			if not running then return end
			local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if not (ok2 and data and data.message) then return end

			-- filtro servidor
			if data.mode == "SERVER" and data.serverId ~= CURRENT_SERVER_ID then return end

			local isMe = (data.username == LocalPlayer.Name)
			if mutedPlayers[data.username] and not isMe then return end

			AppendMessage(data.username, data.nickname or data.username, data.message, isMe, data.mode)
			ShowBubble(data.username, data.message)

			-- notificação: só se não é você e painel fechado
			if not isMe and not MainPanel.Visible then
				if ChatSettings.Notifications then
					NotificationSound:Play()
				end
				ShowToast(data.nickname or data.username, data.message)
			end
		end)

		socket.OnClose:Connect(function()
			if running then
				warn("[PrivateChat] Desconectado. Reconectando em 5s...")
				task.wait(5); ConnectWS()
			end
		end)
	else
		warn("[PrivateChat] Falha ao conectar. Tentando em 5s...")
		task.wait(5); ConnectWS()
	end
end

-- ==========================================
-- 7. SEND MESSAGE (real, com WS) + animação do aviãozinho
-- ==========================================
local function SendMessage()
	local content = ChatInput.Text
	if content:match("^%s*$") then return end
	if not socket then warn("[PrivateChat] Sem conexão."); return end

	ChatInput.Text = ""

	local payload = {
		username = LocalPlayer.Name,
		nickname = LocalPlayer.DisplayName,
		message  = content,
		mode     = isGlobalMode and "GLOBAL" or "SERVER",
		serverId = CURRENT_SERVER_ID
	}
	pcall(function() socket:Send(HttpService:JSONEncode(payload)) end)

	-- render local imediato (não espera eco do servidor)
	AppendMessage(LocalPlayer.Name, LocalPlayer.DisplayName, content, true, payload.mode)
	ShowBubble(LocalPlayer.Name, content)

	-- animação do aviãozinho (mantida)
	TweenService:Create(PaperPlane, TweenInfo.new(0.1), {Position = UDim2.new(0.5, -7, 0.5, -11)}):Play()
	task.delay(0.1, function()
		if PaperPlane and PaperPlane.Parent then
			TweenService:Create(PaperPlane, TweenInfo.new(0.1), {Position = UDim2.new(0.5, -9, 0.5, -9)}):Play()
		end
	end)
end

SendButton.MouseButton1Click:Connect(SendMessage)
ChatInput.FocusLost:Connect(function(enterPressed) if enterPressed then SendMessage() end end)

