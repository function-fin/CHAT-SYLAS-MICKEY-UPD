local toastToken = 0
local function ShowToast(sender, msg)
	if not ChatSettings.Notifications then return end
	local safeS = EscapeRichText(sender)
	local safeM = EscapeRichText(msg)
	ToastText.Text = string.format("<font color='rgb(180,130,255)'>%s:</font> %s", safeS, safeM)
	Toast.Visible = true
	Toast.Position = UDim2.new(0.05, 0, 0, 5)
	toastToken += 1
	local myToken = toastToken
	task.delay(4, function()
		if myToken == toastToken then
			Toast.Visible = false
			Toast.Position = UDim2.new(0.05, 0, 0, -50)
		end
	end)
end

